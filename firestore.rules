rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasFreeDefaults() {
      return request.resource.data.planTier == 'Free'
        && request.resource.data.tier == 'free'
        && request.resource.data.isPro == false
        && request.resource.data.textLimit == 50
        && request.resource.data.imageLimit == 30
        && request.resource.data.videoLimit == 4
        && request.resource.data.textUsed == 0
        && request.resource.data.imageUsed == 0
        && request.resource.data.videoUsed == 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasFreeDefaults();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'welcomeEmailSent', 'ai_brain']);
      allow delete: if false;

      match /chats/{chatId} {
        allow read, write: if isOwner(uid);
      }

      match /assets/{assetId} {
        allow read, write: if isOwner(uid);
      }

      match /vault/{vaultId} {
        allow read, write: if isOwner(uid);
      }

      match /search_vault/{activityId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
