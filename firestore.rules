rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasFreeDefaults() {
      return request.resource.data.planTier == 'Free'
        && request.resource.data.tier == 'free'
        && request.resource.data.isPro == false
        && request.resource.data.textLimit == 50
        && request.resource.data.imageLimit == 30
        && request.resource.data.videoLimit == 4
        && request.resource.data.textUsed == 0
        && request.resource.data.imageUsed == 0
        && request.resource.data.videoUsed == 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasFreeDefaults();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'welcomeEmailSent', 'ai_brain']);
      allow delete: if isOwner(uid);

      match /chats/{chatId} {
        allow read, write: if isOwner(uid);
      }

      match /assets/{assetId} {
        allow read, write: if isOwner(uid);
      }

      match /vault/{vaultId} {
        allow read, write: if isOwner(uid);
      }

      match /search_vault/{activityId} {
        allow read, write: if isOwner(uid);
      }

      match /projects/{projectId} {
        allow read, write: if isOwner(uid);
      }

      match /studio_projects/{projectId} {
        allow read, write: if isOwner(uid);
      }

      match /code_projects/{projectId} {
        allow read, write: if isOwner(uid);
      }

      // OAuth session payloads are AES-encrypted with a server-only key before storage.
      match /connectors/{providerId} {
        allow read, write: if isOwner(uid);
      }

      // Existing encrypted Google sessions can be read during migration only.
      match /private/{documentId} {
        allow read: if isOwner(uid);
      }

      // Zulora Drive metadata is stored in the dedicated Drive Firebase project.
      match /driveFiles/{fileId} {
        allow read, write: if isOwner(uid);
      }

      match /files/{fileId} {
        allow read, write: if isOwner(uid);
      }

      match /drive_files/{fileId} {
        allow read, write: if isOwner(uid);
      }

      match /user_drive_files/{fileId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
