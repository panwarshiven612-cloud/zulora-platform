# Firebase Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=zulora-al.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zulora-al
VITE_FIREBASE_STORAGE_BUCKET=zulora-al.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=791256936681
VITE_FIREBASE_APP_ID=1:791256936681:web:5c52af9f5b76676b2c0078

# Server-only provider keys. Prefer these names in deployed environments.
# Video generation uses Pollinations first, then Fal AI / Replicate. Keep these credentials server-only.
# VITE_* values are included in the browser bundle; use server-only names for provider secrets.
# Deploy the firestore.rules and storage.rules files with Firebase CLI after review.
FIREBASE_PROJECT_ID=zulora-al
# Optional server-side usage tracking credentials. If omitted or unavailable, generation continues without usage tracking.
# FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY are also accepted as aliases.
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@zulora-al.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEY_5=your_gemini_key_5
GEMINI_API_KEY_6=your_gemini_key_6
GEMINI_API_KEY_7=your_gemini_key_7
# A single Google key may also use GEMINI_API_KEY, GOOGLE_API_KEY, or GOOGLE_GENERATIVE_AI_API_KEY instead of the numbered pool.
GROQ_API_KEY=your_groq_key
CEREBRAS_API_KEY=your_cerebras_key
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
# One OpenRouter key may also use OPENROUTER_API_KEY.
MISTRAL_API_KEY=your_mistral_key

POLLINATIONS_API_KEY=your_pollinations_key
HF_API_KEY=your_huggingface_key
FAL_API_KEY=your_fal_key
# Optional browser image fallbacks only. VITE_* credentials ship in the browser bundle; never use these for production secrets.
VITE_HUGGINGFACE_KEY=
VITE_FAL_KEY=
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account
CLOUDFLARE_API_TOKEN=your_cloudflare_token
REPLICATE_API_TOKEN=your_replicate_token

# Contact & Portals
VITE_WHATSAPP_NUMBER=+916395211325
VITE_HELPLINE_EMAIL=zulora.help@gmail.com
VITE_PORTAL_SCHOOL=https://school.zulora.in
