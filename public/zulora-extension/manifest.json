{
  "manifest_version": 3,
  "name": "Zulora AI Computer Plugin",
  "version": "1.5.0",
  "description": "Autonomous browser agent for Zulora AI — controls WhatsApp, Gmail, ChatGPT, Gemini, and any web app with smart LLM generation, voice commands, and offline OCR/PDF engines.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "downloads",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "https://*.zulora.in/*",
      "https://zulora.in/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://zulora.vercel.app/*",
      "https://*.zulora.ai/*",
      "https://zulora-ai.web.app/*",
      "https://zulora-ai.firebaseapp.com/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zulora AI Computer Plugin"
  }
}
