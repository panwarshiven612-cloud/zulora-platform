{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Zulora AI Computer Plugin",
  "version": "1.3.0",
  "description": "Chrome automation agent for Zulora AI — controls browser tabs, Gmail, WhatsApp, ChatGPT, and DOM automation with smart LLM generation.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/dom-selectors.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "downloads",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract/*",
        "lib/tesseract/core/*",
        "lib/tesseract/lang/*",
        "lib/audio/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "externally_connectable": {
    "matches": [
      "https://*.zulora.in/*",
      "https://zulora.in/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://zulora.vercel.app/*",
      "https://*.zulora.ai/*",
      "https://zulora-ai.web.app/*",
      "https://zulora-ai.firebaseapp.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zulora AI Computer Plugin"
  }
}
